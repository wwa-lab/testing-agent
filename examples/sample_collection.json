{
  "name": "Authorization Regression Collection",
  "description": "Sample REST, TCP, MQ and DB tests for AS400 transaction automation.",
  "test_cases": [
    {
      "name": "REST - Health Check",
      "tags": ["rest", "smoke"],
      "request": {
        "protocol": "REST",
        "rest": {
          "method": "GET",
          "url": "https://httpbin.org/status/200",
          "timeout_seconds": 10
        }
      },
      "validations": [
        {
          "name": "HTTP status is 200",
          "source": "status_code",
          "operator": "equals",
          "expected": 200
        }
      ]
    },
    {
      "name": "TCP - Authorization Template",
      "tags": ["tcp", "authorization"],
      "request": {
        "protocol": "TCP",
        "tcp": {
          "host": "{{as400_host}}",
          "port": 9001,
          "encoding": "ebcdic",
          "response_encoding": "ebcdic",
          "payload": "AUTH000000010000000100",
          "timeout_seconds": 30,
          "read_bytes": 4096
        }
      },
      "validations": [
        {
          "name": "Authorization response exists",
          "source": "text",
          "operator": "exists"
        }
      ]
    },
    {
      "name": "MQ - Settlement Template",
      "tags": ["mq", "settlement"],
      "request": {
        "protocol": "MQ",
        "mq": {
          "queue_manager": "QM1",
          "channel": "DEV.APP.SVRCONN",
          "host": "{{mq_host}}",
          "port": 1414,
          "request_queue": "DEV.REQUEST",
          "response_queue": "DEV.RESPONSE",
          "payload": "{\"transactionId\":\"T10001\",\"amount\":100}",
          "correlation_id": "T10001",
          "simulate": true
        }
      },
      "validations": [
        {
          "name": "Correlation ID exists",
          "source": "mqmd",
          "path": "correlation_id",
          "operator": "exists"
        }
      ]
    }
  ],
  "scenarios": []
}

